# Builds the VPN core from this repository.
#
# The build context is the repository root, because the core is no longer a
# separate module: there is one go.mod covering the installer, the core and
# every dependency that used to be reached through a replace directive.
#
#   docker build -f Dockerfile.core -t spaiter-vpn-core:<fork-commit> .
#
# golang:1.27 with GOTOOLCHAIN=local: the image's toolchain is the one the
# build gets, and go.mod's `go 1.27.0` is the floor it checks. The pin matters
# because common/badtls reaches into crypto/tls with //go:linkname, which is
# why -checklinkname=0 is needed at all, and such code is only valid against
# the standard library it was written for. The core was on golang:1.25 until
# 2026-11-09 (Go 1.26 was never run in production; protocol/psiphon, which
# died in init on 1.26, had been dropped). Go 1.27 brings the goroutineleak
# profile, served through experimental.debug.listen like the other profiles.
FROM golang:1.27-alpine AS builder
ARG VERSION=dev
WORKDIR /src

# The whole tree first: go.mod points its replace directives at core/ and
# core/replace/*, so `go mod download` cannot run on go.mod alone.
COPY . .
RUN apk add --no-cache git build-base && \
    export GOTOOLCHAIN=local && \
    go mod download
# A direct `go build` rather than the core's Makefile: the Makefile derives
# LDFLAGS from release/ and .git, both excluded by .dockerignore, which left
# the version string empty and broke the badtls link step.
#
# with_tailscale is deliberately absent, as it is in upstream's default tags
# since 573719dd5. Nothing here uses it: no `tailscale` or `derp` in the live
# config or any of its backups, and none in the bot or the installer (their
# apparent hits are "derP" inside HeaderProtectionKey). A tailscale config
# would now fail with "not included in this build", which is the point --
# that is cheaper than linking a stack nobody uses (core/replace/tailscale
# is hiddify's 1.102.1 fork, kept only because core/go.mod replaces it).
#
# with_masque enables the Cloudflare WARP MASQUE outbound (the "WARP -> server"
# chain the bot builds). It is separate from masque-wg, our self-hosted
# CONNECT-UDP inbound, which needs no tag.
RUN export GOTOOLCHAIN=local && \
    CGO_ENABLED=0 go build -v -trimpath \
      -tags "with_gvisor,with_quic,with_dhcp,with_wireguard,with_utls,with_acme,with_clash_api,with_ccm,with_ocm,with_cloudflared,badlinkname,tfogo_checklinkname0,with_grpc,with_awg,with_xdp,with_masque" \
      -ldflags "-X 'github.com/sagernet/sing-box/constant.Version=${VERSION}' -checklinkname=0 -s -w -buildid=" \
      -o /src/sing-box github.com/sagernet/sing-box/cmd/sing-box

FROM alpine
# OCI provenance so a published image names its own source and licence.
# image.source is the canonical public mirror (GPL-3.0 corresponding source);
# image.revision is the exact commit this core was built from.
ARG REVISION=unknown
ARG SOURCE=https://github.com/spaiter/spaiter-vpn
LABEL org.opencontainers.image.title="spaiter-vpn-core" \
      org.opencontainers.image.description="VPN core (sing-box fork) for spaiter-vpn" \
      org.opencontainers.image.source="${SOURCE}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later"
RUN apk add --no-cache bash tzdata ca-certificates nftables
COPY --from=builder /src/sing-box /usr/local/bin/sing-box
ENTRYPOINT ["sing-box"]
